From dd0913911022a1e5a8f1233a67a1bb29c05982d2 Mon Sep 17 00:00:00 2001
From: Nebel <build@nebel>
Date: Sun, 23 Aug 2026 00:33:31 -0700
Subject: [PATCH] wlserver: offset external touch by 180 when
 --force-external-orientation is active

---
 src/wlserver.cpp | 34 ++++++++++++++++++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/src/wlserver.cpp b/src/wlserver.cpp
index 2d73927..b07d541 100644
--- a/src/wlserver.cpp
+++ b/src/wlserver.cpp
@@ -2810,6 +2810,36 @@ const std::shared_ptr<wlserver_vk_swapchain_feedback>& wlserver_surface_swapchai
 	return wl_surf->swapchain_feedback;
 }
 
+extern GamescopePanelOrientation g_DesiredExternalOrientation;
+
+// Touch orientation for a connector: normally just its current orientation,
+// but with --force-external-orientation the external panel's image rotation
+// is OUR choice, decoupled from how its digitizer is mounted. The udev hwdb
+// calibration for such panels (e.g. Retroid Dual Screen) aligns the touch
+// frame with the desktop stack (kwin's output transform), which ends up
+// 180 degrees apart from what gamescope's transform below expects - add
+// that 180 here so game mode and desktop agree on one hwdb matrix.
+static GamescopePanelOrientation get_touchscreen_orientation( gamescope::IBackendConnector *pConnector )
+{
+	GamescopePanelOrientation eOrientation = pConnector->GetCurrentOrientation();
+	if ( g_DesiredExternalOrientation == GAMESCOPE_PANEL_ORIENTATION_AUTO ||
+		 pConnector->GetScreenType() != gamescope::GAMESCOPE_SCREEN_TYPE_EXTERNAL )
+		return eOrientation;
+
+	switch ( eOrientation )
+	{
+		default:
+		case GAMESCOPE_PANEL_ORIENTATION_0:
+			return GAMESCOPE_PANEL_ORIENTATION_180;
+		case GAMESCOPE_PANEL_ORIENTATION_90:
+			return GAMESCOPE_PANEL_ORIENTATION_270;
+		case GAMESCOPE_PANEL_ORIENTATION_180:
+			return GAMESCOPE_PANEL_ORIENTATION_0;
+		case GAMESCOPE_PANEL_ORIENTATION_270:
+			return GAMESCOPE_PANEL_ORIENTATION_90;
+	}
+}
+
 /* Handle the orientation of the touch inputs */
 static void apply_touchscreen_orientation(GamescopePanelOrientation orientation, double *x, double *y )
 {
@@ -2853,7 +2883,7 @@ void wlserver_touchmotion( double x, double y, int touch_id, uint32_t time, bool
 
 		if ( connector )
 		{
-			apply_touchscreen_orientation(connector->GetCurrentOrientation(), &tx, &ty);
+			apply_touchscreen_orientation(get_touchscreen_orientation(connector), &tx, &ty);
 		}
 
 		tx *= g_nOutputWidth;
@@ -2911,7 +2941,7 @@ void wlserver_touchdown( double x, double y, int touch_id, uint32_t time, gamesc
 
 		if ( connector )
 		{
-			apply_touchscreen_orientation(connector->GetCurrentOrientation(), &tx, &ty);
+			apply_touchscreen_orientation(get_touchscreen_orientation(connector), &tx, &ty);
 		}
 
 		tx *= g_nOutputWidth;
-- 
