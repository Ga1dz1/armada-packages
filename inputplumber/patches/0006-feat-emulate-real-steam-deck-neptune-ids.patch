From 0000000000000000000000000000000000000006 Mon Sep 17 00:00:00 2001
From: nebel <nebel@localhost>
Date: Mon, 31 Aug 2026 00:00:00 +0000
Subject: [PATCH] feat(steam_deck): emulate real Steam Deck (Neptune) IDs by
 default

The default SteamDeckConfig presents the virtual controller as
28DE:12F0 "Generic Steam Controller". Steam's client does not recognize
that PID ("Unrecognized controller using V1 HID protocol") and never
enables the full Deck feature set for it - most notably the trackpads
are ignored entirely in Big Picture and the controller tester even
though the input reports carry valid pad data.

Emulate the real Neptune controller (28DE:1205, "Steam Deck") instead,
so Steam drives the device through its native Deck path with trackpad,
gyro and haptics support enabled.
---
 src/input/target/steam_deck.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/input/target/steam_deck.rs b/src/input/target/steam_deck.rs
--- a/src/input/target/steam_deck.rs
+++ b/src/input/target/steam_deck.rs
@@ -61,9 +61,9 @@ pub struct SteamDeckConfig {
 impl Default for SteamDeckConfig {
     fn default() -> Self {
         Self {
-            vendor: "InputPlumber".to_string(),
-            name: "Generic Steam Controller".to_string(),
-            product_id: ProductId::Generic,
+            vendor: "Valve".to_string(),
+            name: "Steam Deck".to_string(),
+            product_id: ProductId::SteamDeck,
         }
     }
 }
