+/*
+ * Nebel: map MIDR implementer/part to a marketing core name so 64-bit
+ * userspace reading /proc/cpuinfo (lscpu, Steam's system page, games)
+ * sees a real "model name" instead of nothing. Unknown parts fall back
+ * to no line (upstream behavior). Parts are the mainline MIDR values.
+ */
+static const struct {
+	u32 implementer;
+	u32 part;
+	const char *name;
+} midr_part_names[] = {
+	{ 0x41, 0xd05, "Cortex-A55" },
+	{ 0x41, 0xd0d, "Cortex-A77" },
+	{ 0x41, 0xd0e, "Cortex-A76" },
+	{ 0x41, 0xd41, "Cortex-A78" },
+	{ 0x41, 0xd44, "Cortex-X1" },
+	{ 0x41, 0xd46, "Cortex-A510" },
+	{ 0x41, 0xd47, "Cortex-A710" },
+	{ 0x41, 0xd48, "Cortex-X2" },
+	{ 0x41, 0xd4d, "Cortex-A715" },
+	{ 0x41, 0xd4e, "Cortex-X3" },
+	{ 0x41, 0xd80, "Cortex-A520" },
+	{ 0x41, 0xd81, "Cortex-A720" },
+	{ 0x41, 0xd82, "Cortex-X4" },
+	{ 0x41, 0xd85, "Cortex-X925" },
+	{ 0x41, 0xd87, "Cortex-A725" },
+	{ 0x51, 0x001, "Oryon" },
+};
+
+static const char *midr_part_name(u32 midr)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(midr_part_names); i++)
+		if (midr_part_names[i].implementer == MIDR_IMPLEMENTOR(midr) &&
+		    midr_part_names[i].part == MIDR_PARTNUM(midr))
+			return midr_part_names[i].name;
+	return NULL;
+}
