--- a/drivers/firmware/dmi_scan.c	2026-06-01 08:54:55.000000000 -0700
+++ b/drivers/firmware/dmi_scan.c	2026-09-03 10:51:38.151002391 -0700
@@ -8,6 +8,7 @@
 #include <linux/efi.h>
 #include <linux/memblock.h>
 #include <linux/random.h>
+#include <linux/of.h>
 #include <asm/dmi.h>
 #include <linux/unaligned.h>
 
